window.onerror = function(msg, url, line) {
  file.WriteLine('Error: ' + msg + ' at line ' + line);
};
</script>
<script src="js/auth.js"></script>
<script src="js/store.js"></script>
<script>
file.WriteLine('Scripts loaded successfully');
file.Close();
window.close();
</script>
